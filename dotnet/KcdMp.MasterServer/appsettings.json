{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Using": [ "Serilog.Sinks.Console" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },

  "Registry": {
    "MaxServers": 500
  },

  // Proxy support: only turn this on when something in front of this process is setting
  // X-Forwarded-For, or a caller can list a server under any address it likes.
  // A proxy on the same host needs nothing else; one elsewhere has to be named
  // in KnownProxies, e.g. ["10.0.0.2"].
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": []
  }
  // Default: http://127.0.0.1:5100. Set Urls (or ASPNETCORE_URLS) explicitly
  // for an external listener. Use a TLS reverse proxy for a public server.
}
