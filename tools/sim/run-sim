#!/usr/bin/env bash
# Headless smoothness run against the tree you are in.
#   tools/sim/run-sim
#   tools/sim/run-sim pr3 tools/sim/out
# Needs the .NET 8 SDK. No game, no root.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
label="${1:-this-tree}"
out="${2:-$root/tools/sim/out}"
cd "$root"
export SIM_COMMIT="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
extra=()
if [ "$#" -ge 3 ]; then extra=("${@:3}"); fi
dotnet run --project tools/sim/KcdMp.Sim/KcdMp.Sim.csproj -c Release -- --label "$label" --out "$out" "${extra[@]}"
echo "report: $out/sim.md"
