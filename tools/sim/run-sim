#!/usr/bin/env bash
# Headless smoothness run against the tree you are in.
#   tools/sim/run-sim
#   tools/sim/run-sim pr3 tools/sim/out
# Needs the .NET 8 SDK. CI also runs portable C++17 and Python checks.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
label="${1:-this-tree}"
out="${2:-$root/tools/sim/out}"
cd "$root"
export SIM_COMMIT="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
extra=()
if [ "$#" -ge 3 ]; then extra=("${@:3}"); fi
if [ "$label" = ci ]; then
    python3 -B tools/Test-Skills.py
    native_tmp="$(mktemp -d)"
    trap 'rm -rf -- "$native_tmp"' EXIT
    cat > "$native_tmp/main.cpp" <<'EOF'
#include <cstdio>

int holder_contract_tests(int* passed);
int edge_lanes_tests(int* passed);
int rp_timeline_tests(int* passed);
int ranged_aim_tests(int* passed);
int p6_capture_flow_tests(int* passed);
int rp_timeline_action_tests(int* passed);
int rp_controller_tests(int* passed);
int rp_combat_tests(int* passed);
int rp_timeline_outcome_integration(int* passed);
int rp_body_action_tests(int* passed);
int visual_damage_tests(int* passed);
int load_sequence_tests(int* passed);
int wo203_conv_tests(int* passed);
int t3_recovery_stats_tests(int* passed);
int h6_combat_action_tests(int* passed);
int npc_death_release_tests(int* passed);

bool run_tests(const char* name, int (*suite)(int*)) {
    int passed = 0;
    const int failed = suite(&passed);
    std::printf("%s: %d passed, %d failed\n", name, passed, failed);
    return passed > 0 && failed == 0;
}

int main() {
    bool passed = run_tests("body owner contract", &holder_contract_tests);
    passed &= run_tests("modeled DLL lanes", &edge_lanes_tests);
    passed &= run_tests("modeled presentation clock", &rp_timeline_tests);
    passed &= run_tests("bow aim hold", &ranged_aim_tests);
    passed &= run_tests("ranged capture and scope", &p6_capture_flow_tests);
    passed &= run_tests("presentation action order", &rp_timeline_action_tests);
    passed &= run_tests("remote movement and relocation", &rp_controller_tests);
    passed &= run_tests("typed combat presentation", &rp_combat_tests);
    passed &= run_tests("typed combat terminal outcomes (engine doubles)", &rp_timeline_outcome_integration);
    passed &= run_tests("remote knockout and ranged animation", &rp_body_action_tests);
    passed &= run_tests("visual replica damage authority", &visual_damage_tests);
    passed &= run_tests("world load scope and frame fence", &load_sequence_tests);
    passed &= run_tests("ordered dialog votes and apply receipts", &wo203_conv_tests);
    passed &= run_tests("scoped recovery and reconnect diagnostics", &t3_recovery_stats_tests);
    passed &= run_tests("combat action incarnation and retirement", &h6_combat_action_tests);
    passed &= run_tests("native NPC death boundary (engine doubles)", &npc_death_release_tests);
    return passed ? 0 : 1;
}
EOF
    "${CXX:-c++}" -std=c++17 -DKCDMP_P6_CAPTURE_TEST -I native/KCDMP "$native_tmp/main.cpp" \
        native/tests/p6_capture_flow_tests.cpp native/KCDMP/wo201_ranged.cpp \
        native/tests/holder_contract_tests.cpp native/tests/edge_lanes_tests.cpp \
        native/tests/rp_timeline_tests.cpp native/tests/ranged_aim_tests.cpp native/tests/rp_timeline_action_tests.cpp \
        native/tests/rp_controller_tests.cpp native/tests/rp_combat_tests.cpp \
        native/tests/rp_timeline_outcome_integration.cpp \
        native/tests/rp_body_action_tests.cpp native/tests/visual_damage_tests.cpp native/tests/load_sequence_tests.cpp \
        native/tests/wo203_conv_tests.cpp native/tests/t3_recovery_stats_tests.cpp \
        native/tests/h6_combat_action_tests.cpp \
        native/tests/npc_death_release_tests.cpp \
        -o "$native_tmp/native-contracts"
    if ! native_result="$("$native_tmp/native-contracts")"; then
        printf '%s\n' "$native_result" >&2
        exit 1
    fi
    printf '%s\n' "$native_result"
    PYTHONDONTWRITEBYTECODE=1 python3 tools/sim/run-required-python.py discover -s tools/rig -p 'test_rpcombat.py'
    PYTHONDONTWRITEBYTECODE=1 python3 tools/sim/run-required-python.py discover -s tools/rig -p 'test_lane2_melee.py'
    PYTHONDONTWRITEBYTECODE=1 python3 tools/sim/run-required-python.py discover -s tools/rig -p 'test_lane2_h6.py'
    PYTHONDONTWRITEBYTECODE=1 python3 tools/sim/run-required-python.py discover -s tools/rig -p 'test_load_sequence.py'
    PYTHONDONTWRITEBYTECODE=1 python3 tools/sim/run-required-python.py discover -s tools/rig -p 'test_s3_events.py'
    PYTHONDONTWRITEBYTECODE=1 python3 tools/sim/run-required-python.py discover -s tools/rig -p 'test_s3_recovery.py'
    PYTHONDONTWRITEBYTECODE=1 python3 tools/sim/run-required-python.py discover -s tools/rig -p 'test_solo_*.py'
    pwsh -NoLogo -NoProfile -NonInteractive -File tools/rig/Test-Solo-Abend.ps1
    python3 tools/Test-NoInputTooling.py tools/rig/Solo-Abend.ps1 tools/rig/scen_solo_abend.py
    python3 tools/Test-NoScreenshots.py tools/rig/Solo-Abend.ps1 tools/rig/scen_solo_abend.py
    PYTHONDONTWRITEBYTECODE=1 python3 tools/sim/run-required-python.py discover -s tools/rig -p 'test_guided_*.py'
    PYTHONDONTWRITEBYTECODE=1 python3 tools/sim/run-required-python.py discover -s tools/rig -p 'test_session_role.py'
    pwsh -NoLogo -NoProfile -NonInteractive -File tools/Test-TestlaufSynthetic.ps1
    guided_sources=(kdcmp/Data/Scripts/Startup/kdcmp.lua
        dotnet/KcdMp.Client/GuidedRun.cs dotnet/KcdMp.Client/GameBridge.GuidedRun.cs
        dotnet/KcdMp.Client/GameBridge.GuidedRunLogs.cs dotnet/KcdMp.LogPack/GuidedRunVerdictEvidence.cs
        tools/rig/scen_guided_run.py tools/Test-TestlaufSynthetic.ps1 tools/Test-TestlaufSynthetic.lua)
    for guided_source in "${guided_sources[@]}"; do
        if [ ! -f "$guided_source" ]; then
            echo "Guided-run source missing: $guided_source" >&2
            exit 1
        fi
    done
    python3 tools/Test-NoInputTooling.py "${guided_sources[@]}"
    python3 tools/Test-NoScreenshots.py "${guided_sources[@]}"
fi
dotnet run --project tools/sim/KcdMp.Sim/KcdMp.Sim.csproj -c Release -- --label "$label" --out "$out" "${extra[@]}"
if [ "$label" = ci ]; then
    printf '\n## Native rule gates\n\n```text\n%s\n```\n' "$native_result" >> "$out/sim.md"
fi
echo "report: $out/sim.md"
