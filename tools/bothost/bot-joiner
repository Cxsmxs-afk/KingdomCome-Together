"""Start a test peer on a local relay, using the existing avatar and world peers."""

import argparse
from ipaddress import ip_address
import math
import os
from pathlib import Path
import shutil
import subprocess
import sys


TOOLS = Path(__file__).resolve().parents[1]
AVATAR = TOOLS / 'wo121' / 'avatarpeer' / 'AvatarPeer.csproj'
SYNTH = TOOLS / 'wo118' / 'synthpeer' / 'SynthPeer.csproj'
LEGACY = {
    'walk': 'Bot-WalkingGhost.ps1',
    'weapons': 'Bot-WeaponShowcase.ps1',
    'item': 'Bot-ItemPeer.ps1',
    'claim': 'Bot-ItemClaim.ps1',
    'dice': 'Bot-DiceOpponent.ps1',
}


def local_relay(value):
    if value.lower() == 'localhost':
        return '127.0.0.1'
    try:
        if ip_address(value).is_loopback:
            return value
    except ValueError:
        pass
    raise argparse.ArgumentTypeError('Use localhost or a loopback IP for the test relay.')


def command_line(args, forwarded, parser):
    if args.legacy:
        if args.role != 'joiner' or any(value is not None for value in
                (args.save, args.plan, args.scenario, args.origin, args.bow_class, args.ranged_kind, args.tables_pak, args.duration, args.world_time, args.wire_version)):
            parser.error('Pass existing PowerShell script options after -- when using --legacy.')
        shell = shutil.which('powershell') or shutil.which('pwsh')
        if not shell:
            parser.error('PowerShell is required for this existing bot script.')
        if args.legacy != 'weapons':
            forwarded = ['-RelayHost', args.host or '127.0.0.1', *forwarded]
            if args.port is not None:
                forwarded += ['-Port', str(args.port)]
            if args.name is not None:
                forwarded += ['-Name', args.name]
        elif any(value is not None for value in (args.host, args.port, args.name)):
            parser.error('The existing weapon showcase uses its local game console.')
        return [shell, '-NoProfile', '-File', str(TOOLS / LEGACY[args.legacy]), *forwarded]

    if forwarded:
        parser.error('Pass extra options after -- only with --legacy.')
    common = ['--test-bot', '--host', args.host or '127.0.0.1', '--port', str(args.port or 7778)]
    if args.name is not None:
        common += ['--name', args.name]
    if args.duration is not None:
        common += ['--duration', str(args.duration)]
    if args.wire_version is not None:
        common += ['--wire-version', args.wire_version]
    if args.role == 'host':
        if not args.save or args.world_time is None or args.scenario or args.bow_class or args.ranged_kind or args.tables_pak:
            parser.error('The host requires --save and --world-time. Pass --plan in place of --scenario.')
        if not math.isfinite(args.world_time) or args.world_time < 0:
            parser.error('--world-time must be finite and non-negative.')
        program_args = ['--join-host125', str(args.save.resolve()), '--world-time', str(args.world_time), *common]
        if args.plan:
            program_args += ['--bot-plan', str(args.plan.resolve())]
        if args.origin is not None:
            program_args += ['--host-pos', args.origin]
        project = SYNTH
    else:
        if args.save or args.plan or args.world_time is not None:
            parser.error('--save, --plan and --world-time require --role host.')
        program_args = common
        if args.scenario:
            program_args += ['--scenario', str(args.scenario.resolve())]
        if args.origin is not None:
            program_args += ['--origin', args.origin]
        if args.bow_class is not None:
            program_args += ['--bow-class', args.bow_class]
        if args.ranged_kind is not None:
            program_args += ['--ranged-kind', args.ranged_kind]
        if args.tables_pak is not None:
            program_args += ['--tables-pak', str(args.tables_pak.resolve())]
        project = AVATAR
    return ['dotnet', 'run', '--project', str(project), '--configuration', 'Release', '--', *program_args]


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    forwarded = []
    if '--' in argv:
        separator = argv.index('--')
        argv, forwarded = argv[:separator], argv[separator + 1:]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--test-bot', action='store_true', help='Enable the test mode explicitly.')
    parser.add_argument('--role', choices=('joiner', 'host'), default='joiner')
    parser.add_argument('--host', type=local_relay, help='Loopback address of the local relay.')
    parser.add_argument('--port', type=int)
    parser.add_argument('--name')
    parser.add_argument('--duration', type=int, help='Maximum run length in seconds.')
    parser.add_argument('--wire-version', help='Exact VERSION[+BUILD_ID] of the local test artifact.')
    parser.add_argument('--origin', help='Starting coordinates as x,y,z.')
    parser.add_argument('--bow-class', help='Ranged item class for the joiner scenario.')
    parser.add_argument('--ranged-kind', choices=('bow', 'crossbow'), help='Typed P6 ranged station for the joiner (default bow).')
    parser.add_argument('--tables-pak', type=Path, help='Tables.pak from the local Modding Tools installation.')
    parser.add_argument('--scenario', type=Path, help='Override the joiner scenario.')
    parser.add_argument('--save', type=Path, help='External test save for the host.')
    parser.add_argument('--world-time', type=float, help='Calendar.GetWorldTime() of the host test save, in world seconds.')
    parser.add_argument('--plan', type=Path, help='Override the host stream and loot plan.')
    parser.add_argument('--legacy', choices=LEGACY, help='Call an existing PowerShell bot with its options after --.')
    args = parser.parse_args(argv)
    if not args.test_bot or os.environ.get('KCDMP_TEST_BOT') != '1':
        parser.error('Both KCDMP_TEST_BOT=1 and --test-bot are required.')
    if args.port is not None and not 1 <= args.port <= 65535:
        parser.error('--port must be between 1 and 65535.')
    if args.duration is not None and args.duration <= 0:
        parser.error('--duration must be positive.')
    command = command_line(args, forwarded, parser)
    try:
        return subprocess.run(command, check=False).returncode
    except OSError as error:
        parser.exit(2, f'Could not start the test peer: {error.strerror}\n')
    except KeyboardInterrupt:
        return 130


if __name__ == '__main__':
    sys.exit(main())
